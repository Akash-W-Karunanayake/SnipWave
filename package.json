{
  "name": "snipwave",
  "version": "1.0.0",
  "description": "SnipWave — Split, snip, and zip audio files",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.voices.audiocutter",
    "productName": "SnipWave",
    "win": {
      "target": "nsis",
      "icon": "src/icons/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ]
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "electron-is-dev": "^2.0.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
